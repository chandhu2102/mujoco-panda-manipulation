<mujoco model="panda_manipulation_scene">
  <!--
    Manipulation scene: Panda arm + table + one graspable target object.

    Modular by include: the arm lives in robots/panda/panda.xml and owns its own
    <compiler>, <default class="panda"> and <actuator>. This file owns everything
    scene-level (solver options, lighting, table, manipuland, goal marker,
    cameras), so the same arm can be dropped into a different scene without
    edits. Swapping in another arm means changing one include line, provided the
    replacement keeps the joint/site names that PandaRobot resolves.

    Layout: arm base at the world origin on the floor; table top at z = 0.4;
    the object spawns on the table within OBJECT_SPAWN_RANGE (see
    manipulation_env.py), which re-randomizes it on every reset().

    qpos layout (nq = 16): joint1..7 | finger_joint1..2 | object free joint (7)
  -->

  <include file="robots/panda/panda.xml"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic"
          impratio="10" iterations="100" solver="Newton" tolerance="1e-10">
    <!-- elliptic cone + impratio 10 gives grasps that hold instead of creeping;
         the default pyramidal cone lets boxes slide out of the fingers. -->
    <flag multiccd="enable"/>
  </option>

  <statistic center="0.4 0 0.4" extent="1.2" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25" offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7"
             rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.15"/>
    <material name="table_mat" rgba="0.72 0.60 0.44 1" reflectance="0.05"/>
    <material name="object_mat" rgba="0.90 0.25 0.20 1" specular="0.3"/>
    <!-- Deliberately the highest-contrast colour in the scene: it must be
         unmistakable in scripts/enjoy.py against a tan table, a red cube and a
         translucent green goal marker. -->
    <material name="obstacle_mat" rgba="0.30 0.18 0.62 1" specular="0.4"
              reflectance="0.05"/>
  </asset>

  <worldbody>
    <light pos="0.5 0 2.2" dir="0 0 -1" directional="true"
           diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <light pos="1.2 -0.8 1.6" dir="-0.5 0.4 -0.8" diffuse="0.3 0.3 0.3"/>

    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          contype="2" conaffinity="2" condim="3"/>

    <!-- Static table. Top face at z = 0.4 (pos.z + size.z = 0.2 + 0.2). -->
    <body name="table" pos="0.5 0 0.2">
      <geom name="table_top" type="box" size="0.30 0.40 0.20"
            material="table_mat" contype="2" conaffinity="2" condim="4"
            friction="1.0 0.05 0.01"/>
    </body>

    <!--
      Obstacle barrier for the avoidance variant of pick-and-place. A static
      wall, so it is part of the scene rather than the physics state and can
      never be knocked over or dragged -- the policy has to go over it.

      Geometry, and why each number is what it is:

        * centred at x = 0.48, y = 0, spanning x 0.465-0.495. That plane is what
          makes it a divider: envs.tasks.obstacle_pick_place spawns the object at
          x 0.56-0.61 and the goal at x 0.37-0.43, so *every* episode has to cross
          it while carrying the cube. It also sits just past the ready_low reset
          TCP at x ~= 0.450, so the arm starts on the goal side and the barrier is
          between it and the object -- reaching over is the first thing the policy
          has to do, not the last.

          x = 0.48 rather than the 0.51 centre of the table, and that 3 cm is not
          cosmetic. The hand geom is 10 cm long along the jaw axis, so a grasp
          needs roughly 6.5 cm between the wall face and the object centre for
          *any* wrist yaw to clear. Measured over 235 curriculum seeds: at a far
          face of 0.525 the seeder could not place the arm without touching the
          wall on 18.7% of attempts even after preferring collision-free yaws; at
          0.495 that falls to 1.7%, which is at or below the obstacle-free
          baseline. Move this back toward 0.51 only together with the object
          spawn box in obstacle_pick_place.py, and re-measure the seed rate.
        * 0.015 half-extent in x (3 cm thick). Thin, because the cost that
          matters is the height, and every extra centimetre of thickness is taken
          out of the two spawn boxes on either side.
        * 0.25 half-extent in y (50 cm wide). Wider than the reachable workspace
          (y +-0.28 under the OSC task_space bounds), so going *around* the end is
          not an available solution and the only way across is over the top.
          Shorten this to ~0.15 for an easier variant that admits the wide detour.
        * top face at z = 0.50, i.e. 10 cm of clear wall above a table top at
          z = 0.40. A cube carried at its resting height (centre z = 0.42) is
          blocked; clearing the wall needs the cube centre above 0.52, a 10 cm
          lift against a reward whose lift_target is 0.12. That crossing altitude
          is deliberately *above* the floor of the goal_z band (0.50-0.62), so the
          cube has to go up over the wall and then back down onto a low goal
          rather than riding a single monotone rise -- and the lift the wall forces
          stays inside the OSC workspace ceiling of 0.75.

          Not higher, because the barrier competes with the reset pose: ready_low
          holds the finger tips at x 0.443, z 0.571. At a top face of 0.52 that is
          a 3.3 cm gap, which 0.05 rad of arm_noise closed on 2.15% of resets;
          0.50 opens it to ~5.2 cm. ManipulationEnv._reject_start_collisions
          redraws the pose either way, so this is margin, not correctness.

      contype=2 conaffinity=2 puts it in the "static scene" class of the bitmask
      scheme documented in robots/panda/panda.xml, so it collides with the arm
      (contype 1) and with the manipuland (conaffinity 3) but not with the table.
    -->
    <geom name="obstacle" type="box" pos="0.48 0 0.45" size="0.015 0.25 0.05"
          material="obstacle_mat" contype="2" conaffinity="2" condim="3"
          friction="0.8 0.05 0.01"/>

    <!--
      Target object: free-floating 4 cm cube, light enough for the primitive
      finger pads to hold. Pose is overwritten on every reset() by the env, so
      this initial pose only matters for model compilation and the home keyframe.

      Moved from x = 0.5 to x = 0.58 when the obstacle went in: the old pose put
      the cube *inside* the wall, which compiles clean and is only visible as a
      contact spike on the one mj_forward that ManipulationEnv.__init__ runs off
      the home keyframe to size the observation space.
    -->
    <body name="object" pos="0.58 0 0.42">
      <freejoint name="object_joint"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="1.4e-5 1.4e-5 1.4e-5"/>
      <geom name="object_geom" type="box" size="0.02 0.02 0.02"
            material="object_mat" contype="2" conaffinity="3" condim="4"
            friction="1.2 0.1 0.01" solimp="0.98 0.99 0.001" solref="0.005 1"/>
      <site name="object_site" pos="0 0 0" size="0.006"
            rgba="1 1 0 0.5" group="1"/>
    </body>

    <!--
      Goal marker. Purely visual: it has no body, so the env randomizes it by
      writing model.site_pos[goal_site] rather than touching qpos. Keeping it out
      of the physics state means the goal can never be knocked around by the arm.
    -->
    <site name="goal_site" pos="0.5 0 0.55" size="0.025" type="sphere"
          rgba="0.1 0.9 0.2 0.35" group="1"/>

    <!--
      frontview/sideview aim with mode="targetbody" rather than hand-written
      xyaxes. Getting xyaxes right means deriving the look direction as -(x cross
      y); an off-by-a-sign there points the camera at empty floor and the model
      still compiles clean. targetbody cannot be wrong. A wrist camera lives on
      the hand body in panda.xml, since it belongs to the robot, not the scene.
    -->
    <camera name="frontview" mode="targetbody" target="table" pos="1.7 0 1.0"/>
    <camera name="sideview" mode="targetbody" target="table" pos="0.5 -1.5 1.0"/>
    <camera name="topview" pos="0.5 0 1.6" xyaxes="1 0 0 0 1 0"/>
    <camera name="cornerview" mode="targetbody" target="table" pos="1.3 -1.1 1.1"/>
  </worldbody>

  <keyframe>
    <!-- "home": the standard Franka ready pose, gripper open, cube resting on the
         far side of the obstacle (x = 0.58, matching the <body name="object">
         pose above; it was 0.5, which is inside the wall). -->
    <key name="home"
         qpos="0 -0.785 0 -2.356 0 1.571 0.785 0.04 0.04 0.58 0 0.42 1 0 0 0"
         ctrl="0 0 0 0 0 0 0 0.04 0.04"/>
  </keyframe>
</mujoco>
